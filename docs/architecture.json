  "cards": [
    {
      "dot": "cyan",
      "title": "语音主链路",
      "items": [
        "按住热键：Windows 按住 CapsLock，macOS 按住右 Command；松开即上屏",
        "SenseVoice / Fun-ASR-Nano 离线识别（CPU 约 25× 实时，中英混说）",
        "上屏按平台注册：Windows 四级（Ctrl+V → WM_PASTE → UIA → 剪贴板），macOS 两级（Cmd+V → 剪贴板）"
      ]
    },
    {
      "dot": "emerald",
      "title": "跨平台接缝",
      "items": [
        "app/native.py 是全仓唯一 sys.platform 判定点，向上提供统一能力",
        "共享核心两平台共用：asr / recorder / downloader / updater / hotkey_logic",
        "win* 与 mac* 模块同函数面镜像，Windows 现网零回归"
      ]
    },
    {
      "dot": "violet",
      "title": "macOS 原生机制",
      "items": [
        "listen-only CGEventTap 观察热键 + 看门狗超时重启（永不压制按键）",
        "Cmd+V 注入上屏，剪贴板兜底；非激活 NSPanel 指示条不抢键盘焦点",
        "首次运行引导辅助功能 / 输入监控 / 麦克风三项 TCC 授权；macOS 15+（arm64）"
      ]
    }
  ]
