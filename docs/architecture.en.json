  "cards": [
    {
      "dot": "cyan",
      "title": "Voice path",
      "items": [
        "Hold the hotkey: CapsLock on Windows, Right Command on macOS; release and text lands on screen",
        "SenseVoice offline recognition (~25× real time on CPU, mixed Chinese/English speech)",
        "Output registered per platform: four levels on Windows (Ctrl+V → WM_PASTE → UIA → clipboard), two on macOS (Cmd+V → clipboard)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Cross-platform seam",
      "items": [
        "app/native.py is the repo's only sys.platform decision point, exposing a unified capability upward",
        "The shared core serves both platforms: asr / recorder / downloader / updater / hotkey_logic",
        "win* and mac* modules mirror the same function surface, with zero regression on the live Windows build"
      ]
    },
    {
      "dot": "violet",
      "title": "macOS native mechanisms",
      "items": [
        "A listen-only CGEventTap observes hotkeys + a watchdog restarts on timeout (keys are never suppressed)",
        "Cmd+V injection outputs text with a clipboard fallback; the non-activating NSPanel indicator bar never steals keyboard focus",
        "First run guides the three TCC permissions — Accessibility / Input Monitoring / Microphone; macOS 15+ (arm64)"
      ]
    }
  ]
